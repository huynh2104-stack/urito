{
  "name": "urito",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "小規模店舗向けのオフラインPOSシステム / Offline-first point-of-sale PWA for small shops",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "icons": "node scripts/make-icons.mjs",
    "build:images": "node scripts/build-sample-images.mjs",
    "build:site": "vite build --config vite.site.config.ts",
    "build:showcase": "npm run build && npm run build:site && node scripts/assemble-showcase.mjs",
    "build:shop": "tsc -b && vite build --mode shop && python scripts/zip-netlify.py",
    "docs:features": "node scripts/docs-features.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "dexie": "^4.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
